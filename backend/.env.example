# Backend only. Replace placeholders privately; never use VITE_ for these values.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.example.mongodb.net/portfolio
ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
NODE_ENV=development
# A managed host normally supplies PORT. Local default is 3000.
PORT=3000
# Exact allowed frontend origins, comma-separated; no wildcards or URL paths.
CORS_ORIGINS=http://localhost:5173,https://shivam-sharma.me,https://www.shivam-sharma.me
# Optional DNS override. Production otherwise uses the hosting platform resolver.
# DNS_SERVERS=8.8.8.8,8.8.4.4
# Number of trusted reverse-proxy hops, if your host uses one.
# TRUST_PROXY_HOPS=1
# Anonymous aggregate resume-click count, no cookies or visitor identifiers.
ANALYTICS_ENABLED=false
