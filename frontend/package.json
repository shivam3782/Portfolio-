{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/assets.mjs && vite build && node scripts/prerender.mjs && node scripts/verify-build-config.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:legacy && npm run test:unit",
    "test:legacy": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests e2e *.js *.json ../backend ../shared ../docs ../README.md",
    "format:check": "prettier --check src scripts tests e2e *.js *.json ../backend ../shared ../docs ../README.md",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^21.0.4",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "vite": "^8.1.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
