# Public site URL used for canonical and social metadata.
VITE_SITE_URL=https://www.shivam-sharma.me
# Empty uses same-origin /api in local development. For Vercel, set a public HTTPS backend origin.
VITE_API_URL=
# Optional privacy-friendly aggregate resume counter.
VITE_ANALYTICS_ENABLED=false
# Local Vite proxy only.
API_PROXY_TARGET=http://127.0.0.1:3000
# Optional read-only CMS snapshot source during production builds.
# SNAPSHOT_API_URL=https://your-backend.example
