# Public build-time setting. Empty means /api on the frontend's origin.
# Put local overrides in .env.development.local; use hosting env for production.
VITE_API_URL=
# Without a reverse proxy, set the backend ORIGIN (no /api suffix), e.g.:
# VITE_API_URL=https://api.example.com

# Vite dev/preview server only; not exposed to browser code.
API_PROXY_TARGET=http://127.0.0.1:3000
